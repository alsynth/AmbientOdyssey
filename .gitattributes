# Required custom worldgen asset. GitHub advises LFS for large binaries.
# Install Git LFS *before* git add/commit.

# Standard project text handling
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.cfg text eol=lf

# Preserve byte-for-byte Minecraft config inputs (including original CRLF).
release_030/overrides/** -text -eol
# Keep historical Audit1 CSV evidence and catalogues byte-identical.
*.csv -text -eol
# Keep the Tan Trees binary directly in normal Git (private repo; no LFS host needed).
release_030/overrides/config/tanshugetrees/custom_packs/\#main.zip -text -eol -filter -diff -merge
docs/performance/v049-followup/*.toml -text -eol

# Preserve experimental config/rollback and captured evidence bytes for hashes.
experiments/structure-difficulty-v3/** -text -eol
docs/balance/v3-evidence/** -text -eol
docs/balance/pr45-acceptance-evidence/** -text -eol
